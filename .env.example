# Copy this file to .env and fill in your own values.
# .env is gitignored (it holds your Drive folder id); this .example is committed.

# REQUIRED — the Google Drive folder that will hold one timestamped sub-folder per session.
# Take the id from the folder URL: https://drive.google.com/drive/folders/<THIS_PART>
MAIN_FOLDER_ID=your_google_drive_folder_id

# OPTIONAL — defaults shown; uncomment to override.

# OAuth Desktop-client file used only for the first-run browser authorization.
#CLIENT_SECRET_FILE=client_secret.json

# Portable OAuth token written after first auth. Copy this file to other booths
# so they upload as your Google user with no browser step.
#TOKEN_FILE=token.json

# Folder photobooth-app writes finished images into (unchanged in v9).
#WATCH_DIR=./photobooth-data/media/processed_full

# A session is treated as finished once no new file has appeared for this many
# seconds. Raise it if your machine writes the collage slowly and a session
# uploads before the collage lands; lower it for a snappier QR.
#SESSION_QUIET_SECONDS=3

# --- QR code in photobooth-app (booth/main.py + the drive_share plugin) — optional, defaults shown ---

# photobooth-app's address; the uploader follows its /api/sse stream to see each job start and end.
# The quiet window above is only used while that stream is down.
#PHOTOBOOTH_URL=http://localhost:8000

# Local port (127.0.0.1 only) where the uploader serves share links to photobooth-app's drive_share
# plugin. Both read it from here, so change it in this one place.
#LINK_SERVER_PORT=8765

# How long a link request may wait for a session folder that is still being created.
#LINK_WAIT_SECONDS=2

# Saved media id / file name -> Drive folder links, so earlier gallery items keep their QR code.
#LINKS_FILE=links.json

# --- Gesture trigger (gesture/gesture_trigger.py) — all optional, defaults shown ---

# The action a thumbs-up starts (<type>/<index> from its config). PHOTOBOOTH_URL above is shared.
#GESTURE_ACTION=collage/0

# Physical webcam (DirectShow name or index) and the virtual camera photobooth-app reads.
# photobooth-app's camera device_identifier must equal GESTURE_VIRTUAL_CAMERA.
#GESTURE_CAMERA=Integrated Webcam
#GESTURE_VIRTUAL_CAMERA=OBS Virtual Camera

# --- Camera resolution and frame rate — the one place to set them; defaults shown ---
# On every start, run.py writes these into photobooth-app's config.json (the active camera's
# cam_resolution_width / cam_resolution_height / cam_framerate, previous file kept as
# config.json_backup-<time>), and the gesture trigger streams the virtual camera at this size.
# .env wins over photobooth-app's admin UI. The collage canvas size is NOT changed.
# The older GESTURE_WIDTH / GESTURE_HEIGHT / GESTURE_FPS names still work.
#CAMERA_WIDTH=1280
#CAMERA_HEIGHT=720
#CAMERA_FPS=30

# --- More gesture trigger settings ---

# Most hands tracked at once; any of them can trigger. Minimum 1. MediaPipe sets no maximum:
# the real limit is how many hands are big enough in the frame to be found. Raise it for groups
# (e.g. 6 for three people) -- each extra tracked hand costs CPU time on every frame.
#GESTURE_NUM_HANDS=2

# Seconds the thumbs-up must be held, and the pause after a session before the trigger re-arms.
#GESTURE_HOLD_SECONDS=3
#GESTURE_COOLDOWN_SECONDS=3
